{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokesurvivor",
  "compatibility_date": "2026-10-01",
  // Serve only on the custom domain: no public *.workers.dev copy or preview URLs
  // (they would be crawlable duplicates of the whole site).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "poke-survivor.online", "custom_domain": true }],
  // Static-only Worker: no script, Cloudflare serves ./dist directly.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
