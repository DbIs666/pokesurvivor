---
import ContentPage from '../../components/ContentPage.astro';
import TierTable from '../../components/TierTable.astro';
import MoveTable from '../../components/MoveTable.astro';
import JsonLd from '../../components/JsonLd.astro';
import { TIER_ENTRIES, TIERS } from '../../data/tiers';
import { UI } from '../../i18n';

// ItemList in tier order (best first), ranked by mid game, the phase that decides most runs.
const score = (e: (typeof TIER_ENTRIES)[number]) =>
  TIERS.indexOf(e.tiers.mid) * 3 + TIERS.indexOf(e.tiers.early) + TIERS.indexOf(e.tiers.late);
const ranked = [...TIER_ENTRIES].sort((a, b) => score(a) - score(b));
---
<ContentPage locale="es" routeKey="tier-list">
  <JsonLd slot="head" type="ItemList" locale="es" name={UI.es.tierCaption}
    items={ranked.map((e) => ({ name: e.name.es, image: e.sprite }))} />
  <TierTable locale="es" entries={TIER_ENTRIES} caption={UI.es.tierCaption} />
  <MoveTable slot="move-table" locale="es" entries={TIER_ENTRIES} />
</ContentPage>
